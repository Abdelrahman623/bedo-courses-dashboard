@@ -0,0 +1,296 @@
+import React, { useMemo, useState } from 'react';
+import { useNavigate } from 'react-router-dom';
+import {
+  GraduationCap, Compass, Pencil, Trash2,
+  FileText, HelpCircle, BookOpenCheck, CalendarClock,
+} from 'lucide-react';
+import { Card } from '../components/ui/Card';
+import { Button } from '../components/ui/Button';
+import { Modal } from '../components/ui/Modal';
+import { useRoadmapStore } from '../store/roadmapStore';
+import type { Assessment, AssessmentType, Grade } from '../types';
+
+const TONES = ['amber', 'secondary', 'tertiary', 'highlight'] as const;
+type Tone = typeof TONES[number];
+const TONE_CLASSES: Record<Tone, { text: string; solidBg: string; ring: string }> = {
+  amber:     { text: 'text-accent-amber',     solidBg: 'bg-accent-amber',     ring: 'focus:border-accent-amber/50' },
+  secondary: { text: 'text-accent-secondary', solidBg: 'bg-accent-secondary', ring: 'focus:border-accent-secondary/50' },
+  tertiary:  { text: 'text-accent-tertiary',  solidBg: 'bg-accent-tertiary',  ring: 'focus:border-accent-tertiary/50' },
+  highlight: { text: 'text-accent-highlight', solidBg: 'bg-accent-highlight', ring: 'focus:border-accent-highlight/50' },
+};
+
+const TYPE_META: Record<AssessmentType, { label: string; icon: React.ElementType }> = {
+  exam:       { label: 'Exam',       icon: BookOpenCheck },
+  quiz:       { label: 'Quiz',       icon: HelpCircle },
+  assignment: { label: 'Assignment', icon: FileText },
+};
+
+// Same letter bands as roadmapStore's percentageToGradePoint — kept here only
+// for display, the store owns the real 4.0-scale conversion.
+function letterFor(pct: number): string {
+  if (pct >= 93) return 'A';
+  if (pct >= 90) return 'A-';
+  if (pct >= 87) return 'B+';
+  if (pct >= 83) return 'B';
+  if (pct >= 80) return 'B-';
+  if (pct >= 77) return 'C+';
+  if (pct >= 73) return 'C';
+  if (pct >= 70) return 'C-';
+  if (pct >= 67) return 'D+';
+  if (pct >= 60) return 'D';
+  return 'F';
+}
+
+export const Grades: React.FC = () => {
+  const navigate = useNavigate();
+  const {
+    getActiveCourses, getAssessmentsForCourse, getCourseGrade, getGPA,
+    grades, setGrade, deleteGrade,
+  } = useRoadmapStore();
+
+  const activeCourses = getActiveCourses('academic');
+  const toneByCourse = useMemo(() => {
+    const map = new Map<string, Tone>();
+    activeCourses.forEach((c, i) => map.set(c.id, TONES[i % TONES.length]));
+    return map;
+  }, [activeCourses]);
+
+  const gradeByAssessment = useMemo(
+    () => new Map<string, Grade>(grades.map(g => [g.assessment_id, g])),
+    [grades],
+  );
+
+  const gpa = getGPA();
+
+  const [editing, setEditing] = useState<Assessment | null>(null);
+  const [showModal, setShowModal] = useState(false);
+  const [scoreForm, setScoreForm] = useState({ score: '', maxScore: '100' });
+  const [saving, setSaving] = useState(false);
+  const [formError, setFormError] = useState<string | null>(null);
+
+  const openScore = (a: Assessment) => {
+    const existing = gradeByAssessment.get(a.id);
+    setEditing(a);
+    setFormError(null);
+    setScoreForm({
+      score: existing ? String(existing.score) : '',
+      maxScore: existing ? String(existing.max_score) : '100',
+    });
+    setShowModal(true);
+  };
+
+  const closeModal = () => {
+    setShowModal(false);
+    setEditing(null);
+    setFormError(null);
+  };
+
+  const handleSubmit = async (e: React.FormEvent) => {
+    e.preventDefault();
+    if (!editing) return;
+    const score = Number(scoreForm.score);
+    const maxScore = Number(scoreForm.maxScore);
+    if (!scoreForm.score.trim() || Number.isNaN(score)) { setFormError('Enter a score.'); return; }
+    if (!scoreForm.maxScore.trim() || Number.isNaN(maxScore) || maxScore <= 0) { setFormError('Max score must be greater than 0.'); return; }
+    setSaving(true);
+    setFormError(null);
+    try {
+      await setGrade(editing.id, score, maxScore);
+      closeModal();
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const handleClear = async () => {
+    if (!editing) return;
+    const existing = gradeByAssessment.get(editing.id);
+    if (!existing) { closeModal(); return; }
+    setSaving(true);
+    try {
+      await deleteGrade(existing.id);
+      closeModal();
+    } finally {
+      setSaving(false);
+    }
+  };
+
+  const inputCls = 'w-full bg-[#0D1017] border border-white/[0.08] focus:border-accent-amber/50 rounded-lg px-3 py-2 ' +
+    'text-sm text-white placeholder:text-zinc-600 outline-none transition-colors';
+
+  if (activeCourses.length === 0) {
+    return (
+      <div className="p-6 max-w-4xl mx-auto space-y-6">
+        <div>
+          <h1 className="text-2xl font-bold tracking-tight text-white">Grades</h1>
+          <p className="text-xs text-zinc-400 mt-1">Per-course grades and overall GPA across your active academic courses.</p>
+        </div>
+        <Card padding="p-8" hover={false} className="text-center">
+          <div className="mx-auto w-12 h-12 rounded-xl bg-accent-amber/10 border border-accent-amber/20 flex items-center justify-center mb-4">
+            <GraduationCap size={22} className="text-accent-amber" />
+          </div>
+          <h3 className="text-lg font-bold text-white tracking-tight">No academic courses yet</h3>
+          <p className="text-xs text-zinc-400 mt-1.5 max-w-md mx-auto leading-relaxed">
+            Add a course in Academic mode from Courses first, then record scores for its exams and assignments here.
+          </p>
+          <div className="mt-5">
+            <Button variant="primary" size="sm" icon={<Compass size={14} />} onClick={() => navigate('/courses')}>
+              Go to Courses
+            </Button>
+          </div>
+        </Card>
+      </div>
+    );
+  }
+
+  return (
+    <div className="p-6 max-w-4xl mx-auto space-y-6">
+      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
+        <div>
+          <div className="flex items-center gap-2">
+            <GraduationCap size={20} className="text-accent-amber" />
+            <h1 className="text-2xl font-bold tracking-tight text-white">Grades</h1>
+          </div>
+          <p className="text-xs text-zinc-400 mt-1">
+            Score assessments to see each course's grade and your overall GPA.
+          </p>
+        </div>
+        <Button variant="tonal" size="sm" icon={<CalendarClock size={14} />} onClick={() => navigate('/deadlines')}>
+          Manage Assessments
+        </Button>
+      </div>
+
+      {/* ── GPA strip ─────────────────────────────────────────────── */}
+      <div className="bg-[#131722] border border-white/[0.08] rounded-xl overflow-hidden shadow-[inset_0_1px_0_0_rgba(255,255,255,0.04)]">
+        <div className="p-5 flex items-center justify-between">
+          <div>
+            <span className="text-xs text-zinc-400 font-medium">Overall GPA (4.0 scale)</span>
+            <p className="text-[11px] text-zinc-500 mt-0.5">
+              {gpa === null ? 'No grades recorded yet' : `Averaged across ${activeCourses.filter(c => getCourseGrade(c.id).percentage !== null).length} graded course${activeCourses.filter(c => getCourseGrade(c.id).percentage !== null).length === 1 ? '' : 's'}`}
+            </p>
+          </div>
+          <span className="text-3xl font-bold tracking-tight text-white font-mono tabular-nums">
+            {gpa === null ? '—' : gpa.toFixed(2)}
+          </span>
+        </div>
+      </div>
+
+      {/* ── Per-course breakdown ────────────────────────────────────── */}
+      <div className="space-y-4">
+        {activeCourses.map(course => {
+          const assessments = getAssessmentsForCourse(course.id);
+          const courseGrade = getCourseGrade(course.id);
+          const tone = TONE_CLASSES[toneByCourse.get(course.id) ?? 'amber'];
+
+          return (
+            <Card key={course.id} padding="p-5" hover={false}>
+              <div className="flex items-center justify-between gap-3 mb-4">
+                <div className="flex items-center gap-2.5 min-w-0">
+                  <span className={`w-1.5 h-7 rounded-full flex-shrink-0 ${tone.solidBg}`} />
+                  <h2 className="text-sm font-semibold text-white truncate">{course.title}</h2>
+                </div>
+                <div className="text-right flex-shrink-0">
+                  {courseGrade.percentage === null ? (
+                    <span className="text-xs text-zinc-500">Not graded yet</span>
+                  ) : (
+                    <span className={`font-mono text-sm font-semibold ${tone.text}`}>
+                      {courseGrade.percentage.toFixed(1)}% · {letterFor(courseGrade.percentage)} · {courseGrade.gradePoint?.toFixed(1)} GP
+                    </span>
+                  )}
+                  <p className="text-[10px] text-zinc-600 mt-0.5">
+                    {Math.round(courseGrade.weightGraded * 100)}% of grade weight recorded
+                  </p>
+                </div>
+              </div>
+
+              {assessments.length === 0 ? (
+                <p className="text-xs text-zinc-500">
+                  No assessments yet — add one from{' '}
+                  <button onClick={() => navigate('/deadlines')} className="text-accent-amber hover:underline cursor-pointer">
+                    Deadlines
+                  </button>.
+                </p>
+              ) : (
+                <div className="space-y-2">
+                  {assessments.map(a => {
+                    const g = gradeByAssessment.get(a.id);
+                    const TypeIcon = TYPE_META[a.type].icon;
+                    const pct = g && g.max_score > 0 ? (g.score / g.max_score) * 100 : null;
+                    return (
+                      <div
+                        key={a.id}
+                        onClick={() => openScore(a)}
+                        className="flex items-center justify-between gap-3 p-3 rounded-xl bg-white/[0.03] border border-white/[0.06] hover:border-white/20 transition-colors cursor-pointer"
+                      >
+                        <div className="min-w-0 flex items-center gap-2">
+                          <TypeIcon size={13} className="text-zinc-500 flex-shrink-0" />
+                          <div className="min-w-0">
+                            <p className="text-xs font-medium text-white truncate">{a.title}</p>
+                            <p className="text-[10px] text-zinc-500">{Math.round(a.weight * 100)}% of grade</p>
+                          </div>
+                        </div>
+                        <span className={`font-mono text-xs whitespace-nowrap ${g ? 'text-white' : 'text-zinc-600'}`}>
+                          {g ? `${g.score}/${g.max_score} · ${pct?.toFixed(0)}%` : 'Not scored'}
+                        </span>
+                      </div>
+                    );
+                  })}
+                </div>
+              )}
+            </Card>
+          );
+        })}
+      </div>
+
+      {/* Score entry modal */}
+      <Modal open={showModal} onClose={closeModal} title={editing ? `Score: ${editing.title}` : 'Score'}>
+        <form onSubmit={handleSubmit} className="space-y-4">
+          <div className="grid grid-cols-2 gap-3">
+            <div>
+              <label className="block text-xs font-medium text-zinc-400 mb-1.5">Score</label>
+              <input
+                type="number"
+                step="any"
+                className={inputCls}
+                placeholder="e.g. 87"
+                value={scoreForm.score}
+                onChange={e => setScoreForm(f => ({ ...f, score: e.target.value }))}
+                autoFocus
+              />
+            </div>
+            <div>
+              <label className="block text-xs font-medium text-zinc-400 mb-1.5">Out of</label>
+              <input
+                type="number"
+                step="any"
+                min={0.01}
+                className={inputCls}
+                placeholder="e.g. 100"
+                value={scoreForm.maxScore}
+                onChange={e => setScoreForm(f => ({ ...f, maxScore: e.target.value }))}
+              />
+            </div>
+          </div>
+
+          {formError && <p className="text-xs text-rose-400">{formError}</p>}
+
+          <div className="flex items-center justify-between gap-3 pt-2">
+            {editing && gradeByAssessment.has(editing.id) ? (
+              <Button type="button" variant="danger" size="sm" icon={<Trash2 size={13} />} onClick={handleClear} disabled={saving}>
+                Clear Score
+              </Button>
+            ) : <span />}
+            <div className="flex items-center gap-2">
+              <Button type="button" variant="ghost" size="sm" onClick={closeModal} disabled={saving}>
+                Cancel
+              </Button>
+              <Button type="submit" variant="primary" size="sm" loading={saving} icon={<Pencil size={13} />}>
+                Save Score
+              </Button>
+            </div>
+          </div>
+        </form>
+      </Modal>
+    </div>
+  );
+};
